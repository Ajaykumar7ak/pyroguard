# =============================================================================
# PYROGUARD-H | Cloud Backup Configuration (Phase 3)
# =============================================================================
# Instructions:
# 1. Create a project at https://supabase.com
# 2. Run the SQL schema script in docs/SUPABASE_SETUP_GUIDE.md in the Supabase SQL Editor
# 3. Copy this file to .env:
#      copy .env.example .env
# 4. Fill in your project URL and service-role secret key below
# 5. Restart the backend service
#
# IMPORTANT:
# - NEVER commit your real .env file or credentials to source control.
# - The service role key is privileged and must remain exclusively on the local host.
# =============================================================================

# Enable or disable cloud backup synchronization
CLOUD_SYNC_ENABLED=true

# Cloud provider (default: supabase)
CLOUD_PROVIDER=supabase

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Project Settings -> API -> Project API Keys -> service_role)
# Note: Keep this key confidential. Do NOT use the public anon key for backend write sync.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Synchronization interval in seconds (default: 30)
CLOUD_SYNC_INTERVAL_SECONDS=30

# Max records per upload batch (default: 50)
CLOUD_SYNC_BATCH_SIZE=50

# Max retry attempts before moving to exponential backoff penalty
CLOUD_SYNC_MAX_RETRIES=5
